---
import { website_links } from "../../data/consts";

interface StripOffer {
  tag?: string;
  name?: string;
  detail?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  titleEm?: string;
  offers?: StripOffer[];
  contactForm?: boolean;
}

const {
  eyebrow = "Active offers",
  title = "Save on your training",
  titleEm = "save today",
  offers = [
    {
      tag: "Discovery",
      name: "$200 discovery flight",
      detail:
        "Book a discovery flight, and if you enroll you get that flight for free.",
      ctaLabel: "Claim",
      ctaHref: `${website_links.discoveryFlight.path}`,
    },
    {
      tag: "Simulator Block rate",
      name: "$60 / hour simulator block rate",
      detail: "Purchase 10+ hours of simulator time, lock in the rate.",
      ctaLabel: "Claim",
      ctaHref: `${website_links.contact.path}`,
    },
  ],
  contactForm = false,
} = Astro.props;
---

<div class="px-6 lg:px-8 py-6 bg-accent-500">
  <div
    class="bg-[#423731] font-sans max-w-7xl mx-auto rounded-[28px] px-8 md:px-10 py-8 flex flex-col lg:flex-row justify-around items-center"
  >
    {
      (eyebrow || title || titleEm) && (
        <div class="flex flex-col gap-1">
          {eyebrow && (
            <span
              class="text-xs tracking-[0.3em] uppercase text-[#dcc1a6]"
              set:html={eyebrow}
            />
          )}
          {(title || titleEm) && (
            <div class="font-serif text-2xl font-normal text-[#f1f5f8] leading-snug whitespace-nowrap">
              {title && <span set:html={title} />}
              {title && titleEm && <br />}
              {titleEm && (
                <em class="italic text-[#dcc1a6]" set:html={titleEm} />
              )}
            </div>
          )}
        </div>
      )
    }
    {
      offers &&
        offers.map((offer, i) => (
          <a
            href={contactForm ? `#${website_links.contact.id}` : (offer.ctaHref ?? "#")}
            class={`group gap-1.5 py-6 hover:-translate-y-1 transition-all duration-200 ${i === 0 ? "flex flex-col" : "hidden lg:flex lg:flex-col "}`}
          >
            {offer.tag && (
              <span class="text-xs tracking-[0.2em] uppercase text-[#dcc1a6] flex items-center gap-1.5">
                <span class="w-3 h-px bg-[#dcc1a6] inline-block" />
                <span set:html={offer.tag} />
              </span>
            )}
            {offer.name && (
              <div
                class="text-lg font-medium text-[#f1f5f8] leading-snug"
                set:html={offer.name}
              />
            )}
            {offer.detail && (
              <div
                class="text-[#c2d5df] leading-relaxed lg:max-w-xs"
                set:html={offer.detail}
              />
            )}
            {(offer.ctaLabel || offer.ctaHref || contactForm) && (
              <div class="inline-flex items-center gap-1.5 text-xs lg:text-base tracking-[0.15em] uppercase text-[#dcc1a6] no-underline mt-1 transition-all duration-200 group-hover:gap-2.5 w-fit">
                <span set:html={offer.ctaLabel ?? "Claim"} />
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </a>
        ))
    }
  </div>
</div>
