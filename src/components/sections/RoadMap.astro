---
import ImageComp from "../utils/ImageComp.astro";

export interface RoadMapStep {
  title: string;
  description: string;
  icon?: string;
  image?: {
    src: string;
    alt: string;
  };
  link?: {
    title?: string;
    href: string;
  };
}

export interface RoadMapData {
  image: {
    src: string;
    alt: string;
  };
  upperHeading?: string;
  title: string;
  description?: string;
  descriptions?: string[];
  bullets: RoadMapStep[];
}

export interface Props {
  content?: RoadMapData;
  data?: RoadMapData;
}

const { content, data } = Astro.props;
const roadMapData = content || data;
---

{
  roadMapData && (
    <section class="relative py-12 bg-stone-100 text-primary-600">
      {roadMapData.upperHeading && (
        <div
          class="bg-primary-300 text-white rounded-l-full text-2xl px-4 py-2 pr-[20%] lg:pr-[30%] absolute top-6 right-0 sm:right-0 sm:top-16"
          data-aos="fade-left"
        >
          {roadMapData.upperHeading}
        </div>
      )}

      {roadMapData.image && (
        <div
          class="lg:absolute inset-0 left-0 top-12 z-10 md:w-3/4 lg:w-1/3 xl:1/3 max-h-3/4 mt-12 flex justify-end"
          data-aos="fade-right"
        >
          <ImageComp
            src={roadMapData.image.src}
            alt={roadMapData.image.alt}
            classes="object-cover h-full rounded-tr-full rounded-br-full w-full"
          />
        </div>
      )}

      <div class="mx-auto flex max-w-4xl flex-col overflow-hidden md:flex-row">
        <div
          class="flex flex-col px-6 py-10 sm:px-10 lg:py-16 text-right items-end text-primary-600 w-full pb-20"
          data-aos="zoom-in"
          data-aos-delay="300"
        >
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-pretty my-6 max-w-3xl">
            {roadMapData.title}
          </h2>

          {roadMapData.description && !roadMapData.descriptions && (
            <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-pretty lg:w-2/3">
              {roadMapData.description}
            </p>
          )}

          {roadMapData.descriptions && (
            <div class="max-w-xl pl-12 flex flex-col justify-end items-end">
              <p>
                {roadMapData.descriptions.map(
                  (description: string) => `${description} `,
                )}
              </p>
            </div>
          )}

          {roadMapData.bullets && (
            <div>
              {roadMapData.bullets.map((step: RoadMapStep) => (
                <div
                  class="mt-10 flex flex-col items-end max-w-sm"
                  data-aos="fade-up"
                >
                  {step.link ? (
                    <a href={step.link.href} class="btn-accent btn-right">
                      {step.title}
                    </a>
                  ) : (
                    <h3 class="font-semibold text-2xl mb-2 uppercase">
                      {step.title}
                    </h3>
                  )}
                  <p class="text-gray-500 max-w-2xl text-xl mt-2 py-2">
                    {step.description}
                  </p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

