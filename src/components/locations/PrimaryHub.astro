---
interface Props {
  homeBase?: {
    id: string;
    data: {
      city: string;
      stateShort: string;
      header: {
        description: string;
      };
      [key: string]: any;
    };
  };
  badge?: string;
  airportCode?: string;
  airportName?: string;
  buttonText?: string;
}

const {
  homeBase,
  badge = "Our Primary Hub",
  airportCode = "KIXD",
  airportName = "New Century AirCenter",
  buttonText = "Visit Our Base &rarr;",
} = Astro.props;
---

{
  homeBase && (
    <section class="w-full bg-accent-50 py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="overflow-hidden rounded-[2rem] bg-[#423731] text-white shadow-xl">
          <div class="grid md:grid-cols-2">
            <div class="p-10 lg:p-16 flex flex-col justify-center">
              {badge && (
                <span
                  class="text-[#dcc1a6] font-semibold uppercase tracking-widest text-sm"
                  set:html={badge}
                />
              )}
              <h2 class="mt-3 text-4xl font-bold">
                <span set:html={homeBase.data.city} />,{" "}
                <span set:html={homeBase.data.stateShort} />
              </h2>
              {homeBase.data.header?.description && (
                <p
                  class="mt-5 text-[#dcc1a6]/80 text-lg leading-relaxed"
                  set:html={homeBase.data.header.description}
                />
              )}
              <a
                href={`/pilot-training/${homeBase.id.replace(/\.mdx?$/, "")}/`}
                class="mt-8 inline-block w-fit bg-[#4b7992] text-white font-bold py-3 px-8 rounded-full hover:bg-[#3a5f73] transition-all duration-300"
              >
                <span set:html={buttonText} />
              </a>
            </div>
            <div class="bg-[#5d4d40] flex items-center justify-center p-10">
              <div class="text-center">
                <p class="text-7xl font-bold text-white/10" set:html={airportCode} />
                <p
                  class="text-[#dcc1a6] uppercase tracking-widest mt-2 font-medium"
                  set:html={airportName}
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
